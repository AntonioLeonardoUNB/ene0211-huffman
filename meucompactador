#!/usr/bin/env python3
"""Ponto de entrada executável para o compactador/descompactador Huffman.

Uso esperado:
    ./meucompactador -c arquivo
    ./meucompactador -d arquivo.huff
"""

import sys
from pathlib import Path

# Garante que o diretório raiz do projeto esteja no sys.path mesmo se o script
# for invocado a partir de outro diretório de trabalho.
RAIZ_PROJETO = Path(__file__).resolve().parent
if str(RAIZ_PROJETO) not in sys.path:
    sys.path.insert(0, str(RAIZ_PROJETO))

from src.cli import main


if __name__ == "__main__":
    raise SystemExit(main())
